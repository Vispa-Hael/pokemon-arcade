{
  "name": "pokemon-arcade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/package-legacy.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "import:data": "node --experimental-strip-types scripts/import-data.ts",
    "import:all": "node scripts/fetch-dex-tables.mjs && node --experimental-strip-types scripts/import-national-dex.ts && node --experimental-strip-types scripts/publish-national-dex.ts",
    "start:arcade": "node scripts/launch-arcade.mjs",
    "stop:arcade": "node scripts/launch-arcade.mjs --stop",
    "test:launcher": "node scripts/test-launcher.mjs",
    "snapshot:legacy": "node scripts/package-legacy.mjs --snapshot",
    "test:release": "node scripts/test-release.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.0.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
